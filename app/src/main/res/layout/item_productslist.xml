<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cardview_default_margin_botton"
    app:cardCornerRadius="@dimen/cardview_item_default_corner_radius"
    app:cardElevation="@dimen/cardview_default_elevation"
    android:clickable="true"
    android:focusable="true"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/cardview_default_padding"
        >
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_marginStart"
            android:layout_gravity="center_vertical"
            >
            <TextView
                android:id="@+id/TXT_ITProductList_Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoria: Abarrotes"
                android:textSize="@dimen/ITTextView_textsize"
                android:layout_marginBottom="@dimen/ITMarginBotton"
                />
            <TextView
                android:id="@+id/TXT_ITProductList_Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arroz"
                android:textSize="@dimen/ITTextView_textsize"
                android:layout_marginBottom="@dimen/ITMarginBotton"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/TXT_ITProductList_Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio: 4.99bs"
                android:textSize="@dimen/ITTextView_textsize"
                android:layout_marginBottom="@dimen/ITMarginBotton"
                />
                <Button
                    android:id="@+id/BTN_ITProductList_Buy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ITProductList_BTNBuyProduct"
                    android:textSize="@dimen/ITTextView_textsize"
                    android:paddingHorizontal="@dimen/button_horizontal"
                    />

        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/cardview_imagen"
            android:layout_height="@dimen/cardview_imagen"
            app:cardCornerRadius="@dimen/cardview_item_default_corner_radius"
            android:elevation="0dp"
            >
            <ImageView
                android:id="@+id/IMV_ITProductList_ProductImagen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/product"
                android:src="@drawable/ic_surmarket"
                />

        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.cardview.widget.CardView>