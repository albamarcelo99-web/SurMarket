<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentAddProduct"
    >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/fragment_padding"
            >
            <androidx.cardview.widget.CardView
                android:id="@+id/CRV_FRGAddProduct_Image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/carview_image_heigt"
                android:layout_marginBottom="@dimen/cardview_default_margin_botton"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/cardview_default_corner_radius_2"
                app:cardElevation="@dimen/cardview_default_elevation"
                >
                <ImageView
                    android:id="@+id/IMV_FRGAddProduct_Image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/product_image"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_surmarket"
                    />
            </androidx.cardview.widget.CardView>
            <Button
                android:id="@+id/BTN_FRGAddProduct_AddImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FRGAddProductsList_BTNAddImage"
                android:textSize="@dimen/frgbutton_textsize"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/ITMarginBotton"
                />
            <TextView
                android:id="@+id/TXV_FRGAddProduct_ProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FRGAddProduct_TXVProductName"
                android:textSize="@dimen/frg_label_textsize"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"
                />
            <EditText
                android:id="@+id/ETX_FRGAddProduct_ProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16sp"
                android:hint="@string/FRGAddProduct_ETXProductName"
                android:inputType="text"
                android:textSize="@dimen/frg_edittext_textsize"
                />
            <TextView
                android:id="@+id/TXV_FRGAddProduct_ProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FRGAddProduct_TXVProductPrice"
                android:textSize="@dimen/frg_label_textsize"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"
                />
            <EditText
                android:id="@+id/ETX_FRGAddProduct_ProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16sp"
                android:hint="@string/FRGAddProduct_ETXProductPrice"
                android:inputType="text"
                android:textSize="@dimen/frg_edittext_textsize"
                />

        </LinearLayout>
    </ScrollView>
</LinearLayout>